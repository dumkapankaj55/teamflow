NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/teamflow
ACCESS_TOKEN_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
REQUIRE_EMAIL_VERIFICATION=false
COOKIE_NAME=teamflow_refresh
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
CORS_ORIGINS=http://localhost:5173
CLIENT_URL=http://localhost:5173
PASSWORD_RESET_URL=http://localhost:5173/reset-password
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=TeamFlow <no-reply@example.com>
# Cloudflare Turnstile test keys for local development only. Replace both in production.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
LOG_LEVEL=debug
# Optional. Errors are sent without request bodies, cookies, authorization headers, or user identifiers.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0
# Optional subscription billing. Use Stripe test keys and test Price IDs for development.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=
SALES_EMAIL=
