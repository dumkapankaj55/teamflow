# Development reference. Copy server values to server/.env and VITE_API_URL to client/.env.
NODE_ENV=development
REQUIRE_EMAIL_VERIFICATION=false
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/teamflow
ACCESS_TOKEN_SECRET=replace-with-a-random-secret-at-least-32-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_NAME=teamflow_refresh
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
CORS_ORIGINS=http://localhost:5173
CLIENT_URL=http://localhost:5173
PASSWORD_RESET_URL=http://localhost:5173/reset-password
# Server-only Resend API key and a sender address verified with Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=TeamFlow <no-reply@example.com>
VITE_API_URL=/api/v1
# Cloudflare Turnstile testing credentials only; replace both keys in production.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Optional Stripe test-mode configuration for hosted subscriptions.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=
SALES_EMAIL=
